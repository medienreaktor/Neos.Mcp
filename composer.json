{
    "name": "medienreaktor/neos-mcp",
    "type": "neos-package",
    "description": "Serves the operations of neos/openapi APIs, preconfigured for the Neos API, as MCP tools authorized by Neos.OAuth",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "neos/flow": "^9.0",
        "medienreaktor/neos-oauth": "^0.1",
        "neos/openapi-flowadapter": "*",
        "medienreaktor/neos-openapi-mcp": "^0.1",
        "guzzlehttp/psr7": "^2.4",
        "medienreaktor/neos-api": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Neos\\Mcp\\": "Classes/"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Neos.Mcp"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
